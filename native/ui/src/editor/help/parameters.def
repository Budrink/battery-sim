// One source for tooltips and the generated parameter reference. SI keys are not UI labels.
PARAMETER("heat_capacity_j_per_k", "Total heat capacity [J/K]", "Energy required to raise this entire object by one kelvin. Not specific heat per kg. For battery contents, reactive and liquid contributions are INCLUDED; the metal shell is additional. Must exceed the sum of component capacities.")
PARAMETER("mass_kg", "Reactive mass [kg]", "Mass available to the battery reaction chain. Together with specific heat it contributes to heat storage; together with reaction energy it limits the chemical reserve. UI may display grams.")
PARAMETER("reactant_cp", "Original material specific heat [J/(kg K)]", "Sensible heat stored per kilogram per kelvin in unreacted material. This is not the energy released by R2.")
PARAMETER("activated_cp", "R2 precursor specific heat [J/(kg K)]", "Heat storage of material converted into precursor, before R2 consumes it.")
PARAMETER("residue_cp", "Residue specific heat [J/(kg K)]", "Heat storage of the solid reaction product; residue is not removed from the thermal balance.")
PARAMETER("initial_mass_kg", "Initial inventory mass [kg]", "Mass initially present in this liquid or gas inventory. The displayed section identifies the substance; liquid and initial cavity gas are separate inventories. UI may display g or mg.")
PARAMETER("liquid_cp", "Liquid specific heat [J/(kg K)]", "Sensible heat storage of unvaporized liquid, distinct from latent heat of evaporation.")
PARAMETER("conductivity_w_per_m_k", "Thermal conductivity along local X/Y/Z [W/(m K)]", "Conductivity of the material, not a whole-contact conductance. Geometry, contact area and state-dependent connectivity determine the final heat transfer.")
PARAMETER("residue_conductivity", "Residue conductivity ratios", "Directional conductivity multipliers relative to original material. Values below one conduct less; they do not change heat capacity or chemical energy.")
PARAMETER("background_factor", "Background conduction multiplier", "Scales the background part of internal thermal connectivity.")
PARAMETER("active_factor", "State-dependent conduction multiplier", "Scales the additional internal conduction controlled by the connectivity state.")
PARAMETER("destroyed_background_factor", "Destroyed background multiplier", "Background internal conduction after destruction; no restoration of intact material is implied.")
PARAMETER("destroyed_active_factor", "Destroyed active multiplier", "State-dependent internal conduction amplitude after destruction.")
PARAMETER("degradation_rate_per_s", "R1 reference rate [1/s]", "Heat-neutral degradation rate at the R1 reference temperature. Damage produces some R2 precursor and changes electrical/material properties.")
PARAMETER("degradation_reference_k", "R1 reference temperature", "Temperature at which the specified R1 rate is defined. UI uses Celsius; contract uses kelvin.")
PARAMETER("degradation_activation_j_per_mol", "R1 activation energy", "Controls temperature sensitivity of degradation through Arrhenius kinetics. Raising it does not mean a universally higher rate: compare temperatures to the reference.")
PARAMETER("precursor_yield", "R1 precursor yield [0..1]", "Fraction of degraded reactive material that becomes R2 precursor rather than inert degradation product.")
PARAMETER("initial_precursor_fraction", "Initial degraded precursor fraction [0..1]", "R2 precursor already present before the run; distinct from material charged electrically.")
PARAMETER("initial_charged_fraction", "Initial charged material fraction [0..1]", "Initial chemical reserve associated with charge. Fractions share a finite material inventory; they are not extra mass.")
PARAMETER("reaction_rate_per_s", "R2 / R3 reference reaction rate [1/s]", "Rate at the reference temperature of the reaction in this section. R2 consumes battery precursor; R3 consumes gas fuel with oxygen. They have independent rates.")
PARAMETER("reaction_reference_k", "Reaction reference temperature", "Temperature defining the reference rate, not a trigger temperature. UI uses Celsius; the solver uses kelvin.")
PARAMETER("reaction_activation_j_per_mol", "Reaction activation energy", "Arrhenius temperature sensitivity. Larger activation energy steepens acceleration ABOVE the reference and suppresses the rate BELOW it; it does not directly increase available energy.")
PARAMETER("net_heat_j_per_kg", "R2 specific chemical energy", "Chemical energy released per reacted mass, limited by precursor inventory. Independent of sensible heat capacity. UI displays kJ/kg.")
PARAMETER("gas_yield", "R2 gas mass yield [kg/kg]", "Base fraction of reacted mass converted into gas. Changes gas inventory, pressure and mass-carried energy, not just visual smoke.")
PARAMETER("gas_yield_max", "Maximum R2 gas mass yield [kg/kg]", "Upper yield used by the state-dependent gas production law. Must remain consistent with the base yield and mass conservation.")
PARAMETER("gas_chemical_fraction", "Chemical energy retained in gas [0..1]", "Share of released chemical energy exported as combustible gas reserve rather than immediately deposited as heat inside the battery.")
PARAMETER("density_kg_m3", "Material density [kg/m3]", "Mass per material volume. For plates, density times volume sets mass; density times specific heat times volume sets heat capacity.")
PARAMETER("latent_j_per_kg", "Latent heat of evaporation", "Energy absorbed per kilogram of liquid vaporized and returned on condensation. Distinct from R2/R3 chemical energy.")
PARAMETER("boiling_temperature_k", "Reference boiling temperature", "Boiling temperature at the reference saturation pressure; local phase equilibrium also depends on pressure.")
PARAMETER("saturation_reference_pa", "Reference saturation pressure", "Pressure paired with the reference boiling temperature in the liquid/vapour equilibrium law. UI displays kPa.")
PARAMETER("relaxation_per_s", "Phase relaxation rate [1/s]", "How rapidly liquid/vapour exchange approaches the model's local equilibrium. Energy and remaining liquid inventory constrain the exchange.")
PARAMETER("resistance_ohm", "Electrical resistance", "Reference resistance of this battery or circuit branch. Joule heating is I squared R and remains subject to the electrical energy balance. Battery UI uses milliohm; branch UI uses ohm.")
PARAMETER("nominal_capacity_coulomb", "Nominal electrical capacity", "Charge capacity, displayed in Ah (3600 coulomb per Ah). Not heat capacity. Used by charging/degradation laws.")
PARAMETER("charge_acceptance_fraction", "Charge acceptance [0..1]", "Fraction governing conversion of supplied charge into chemical reserve, subject to available capacity and energy.")
PARAMETER("thickness_m", "Wall or shell thickness", "Physical plate thickness. With area, density and specific heat it sets thermal mass. UI uses mm.")
PARAMETER("specific_heat_j_kg_k", "Material specific heat [J/(kg K)]", "Heat storage per kilogram per kelvin. Multiply by physical mass to obtain the whole object's J/K.")
PARAMETER("contents_contact_h", "Contents-to-shell heat transfer [W/(m2 K)]", "Simple contact coefficient per area, used when no explicit state-dependent contact law overrides it.")
PARAMETER("seam_contact_h", "Between-plate heat transfer [W/(m2 K)]", "Thermal contact between neighbouring shell plates, not valve mass permeability.")
PARAMETER("damage_onset_k", "Thermal damage onset temperature", "Temperature scale where thermal damage starts accumulating. Does not by itself open a hole; pressure and fracture mechanics still apply.")
PARAMETER("damage_rate_per_s", "Thermal damage rate [1/s]", "Rate of irreversible plate damage at its onset. Zero disables this thermal damage term; it does not disable an independently configured pressure vent.")
PARAMETER("damage_scale_k", "Damage temperature scale [K]", "Temperature rise for an e-fold increase of the damage rate. Smaller values give steeper temperature sensitivity.")
PARAMETER("destroyed_conductance_factor", "Destroyed conduction multiplier", "Remaining conduction relative to intact material after destruction. Does not heal when the temperature drops.")
PARAMETER("conductance_w_per_k", "Contact conductance [W/K]", "Whole-contact heat flow per kelvin difference. Unlike conductivity, geometry/area are already included.")
PARAMETER("background_conductance_w_per_k", "Background contact conductance", "Baseline term in the connectivity law. Units are W/K for a whole contact, W/(m2 K) in a per-area shell law; follow the field label.")
PARAMETER("active_conductance_w_per_k", "State-dependent contact amplitude", "Additional conductance modulated by current connectivity. Units depend on whether this is a whole-contact or per-area law.")
PARAMETER("destroyed_background_conductance_w_per_k", "Destroyed background contact conductance", "Baseline contact term after destruction. Whole-contact or per-area units are shown in the field label.")
PARAMETER("destroyed_active_conductance_w_per_k", "Destroyed active contact amplitude", "State-dependent contact term after destruction; separate from the intact term.")
PARAMETER("geometry_reference_logit", "Reference connectivity bias", "Dimensionless log-odds bias of the connectivity activation. It is not conductivity or contact area.")
PARAMETER("endpoint_damage_weight", "Damage influence on connectivity", "Weights endpoint damage in the existing connectivity law; does not add a separate heat source.")
PARAMETER("oxidizer_heat_j_per_kg", "R3 energy per consumed oxygen mass", "Heat budget per kilogram of oxygen consumed, displayed in MJ/kg O2. NOT a fuel heating value. R3 is limited by both oxygen and available fuel energy.")
PARAMETER("vapor_fuel_heat_j_kg", "Vapour fuel chemical energy", "Chemical reserve carried per kilogram of evaporated liquid, displayed in MJ/kg vapour. Changes the liquid chemical reserve globally, not its heat capacity or latent heat.")
PARAMETER("ignition_temperature_k", "Optional R3 cutoff temperature", "Explicit lower gas-temperature cutoff for R3. With cutoff disabled, the Arrhenius rate still controls burning. Oxygen is always required.")
PARAMETER("initial_temperature_k", "Initial temperature", "Temperature at time zero; UI uses Celsius and the contract kelvin. In a heater controller this is the initial TARGET, while apparatus temperature and sensor temperature are separate fields.")
PARAMETER("sensor_id", "Controller sensor", "ID of the battery/shell element monitored by this heater. It controls the target feedback and cutoff, not where heat is applied.")
PARAMETER("ramp_k_per_s", "Target heating rate", "Rate of the controller's target ramp, shown in C/min. It is not guaranteed actual heating: power limits, losses and reactions still determine temperature.")
PARAMETER("proportional_w_per_k", "Controller gain [W/K]", "Additional heater command per kelvin of target-minus-sensor error. The command is clipped to nonnegative power and maximum power.")
PARAMETER("maximum_power_w", "Maximum heater power [W]", "Upper bound on controller output. Must be positive and no smaller than base power.")
PARAMETER("feedforward_w", "Base heater power [W]", "Feedforward contribution to the controller command. Gain zero gives constant base power until cutoff.")
PARAMETER("cutoff_temperature_k", "Cutoff sensor temperature", "Temperature threshold for latching this heater off. If a positive rise threshold is set, BOTH conditions are required. No automatic restart after cooling.")
PARAMETER("cutoff_rate_k_per_s", "Cutoff minimum rise [C/s]", "Required sensor heating rate together with the cutoff temperature. Zero means temperature-only cutoff.")
PARAMETER("heater_contact_h", "Heater contact [W/(m2 K)]", "Reference heater-to-battery heat transfer per area. Editing scales all contact sectors while retaining the existing temperature/damage response.")
PARAMETER("heater_power_w", "Uncontrolled heater power [W]", "Constant electrical heater power without a controller. With controller enabled, use base power, gain and maximum instead.")
PARAMETER("opening_pressure_pa", "Plate rupture pressure difference", "Pressure DIFFERENCE across the shell plate, displayed in kPa. Damage, temperature and a valve/seam strength factor modify the effective local threshold.")
PARAMETER("area_rate_per_s", "Opening growth rate [1/s]", "Controls how rapidly the fracture aperture grows above the effective pressure threshold. Not a gas velocity or reaction rate.")
PARAMETER("fracture_energy_j_per_m2", "Fracture energy [J/m2]", "Energy cost per newly opened area, charged to the thermodynamic balance during rupture.")
PARAMETER("pressure_factor", "Valve/seam relative strength [0..1]", "Weak-region pressure threshold multiplier relative to the surrounding plate. Smaller values open the weak region more easily.")
PARAMETER("radius_m", "Valve radius", "Radius of the circular weak region in the selected shell face. It must fit within that face. UI uses mm.")
PARAMETER("seam_width_m", "Perimeter seam width", "Width of the weakened strip around the shell face boundary, displayed in mm.")
PARAMETER("valve_center", "Valve center U/V", "Local coordinates on the chosen face, relative to its center. U and V follow the two cyclic axes perpendicular to the face normal.")
PARAMETER("gas_destination", "Vent destination", "Existing gas region reached after shell opening; outside_domain means exterior. Selecting a route is not forced ventilation.")
PARAMETER("volumetric_heat_capacity_j_m3_k", "Volumetric heat capacity [J/(m3 K)]", "Density times specific heat. Multiplying by wall volume gives its total thermal capacity.")
PARAMETER("inside_dimensions_m", "Case internal dimensions", "Free cavity dimensions before subtracting batteries and pads. UI uses mm. Locked for imported explicit gas meshes to avoid silently invalidating their topology.")
PARAMETER("position_m", "Object center", "Position in assembly coordinates, displayed in mm. Moving an object does not automatically rewire solid contacts or the electrical network.")
PARAMETER("dimensions_m", "Contents dimensions", "Prism width/length/height or cylinder radius/height in the contract. UI displays cylinder DIAMETER. Shell is additional; mass and total heat capacity are not automatically rescaled.")
PARAMETER("orientation_xyzw", "Orientation quaternion X/Y/Z/W", "Rotation in assembly coordinates; identity is 0,0,0,1. Not Euler angles. Use a normalized quaternion.")
PARAMETER("damage", "Initial damage [0..1]", "Initial accumulated degradation of the selected element, not a requested rupture area.")
PARAMETER("charged_fraction", "Initial state of charge [0..1]", "Initial charged fraction override for the selected battery, distinct from thermal damage.")
PARAMETER("ambient_temperature_k", "Ambient temperature", "External environment temperature used by case boundary generation. UI uses Celsius.")
PARAMETER("gas_contact_h_w_m2_k", "Gas-to-case heat transfer [W/(m2 K)]", "Reference per-area heat transfer from cavity gas to the case wall through the common connectivity model.")
PARAMETER("solid_contact_h_w_m2_k", "Gas-to-solid heat transfer [W/(m2 K)]", "Reference per-area gas contact with solid objects for the generated cavity mesh. Not a direct solid-to-solid contact.")
PARAMETER("ambient_h_w_m2_k", "Case-to-environment heat transfer [W/(m2 K)]", "External case heat loss coefficient. Zero disables this cooling channel; the case still stores and exchanges heat internally.")
PARAMETER("gas_cell_size_m", "Maximum gas cell size", "Requested cavity gas resolution, displayed in mm. The compiler fits cells to geometry; smaller values increase work and require convergence checks.")
PARAMETER("gas_discharge_coefficient", "Gas passage discharge coefficient", "Dimensionless multiplier of pressure-driven flow through generated passages. Not gas diffusivity or wall conductivity.")
PARAMETER("initial_oxidizer_mass_fraction", "Initial oxygen mass fraction", "Oxygen inventory in the selected cavity, displayed as percent. R3 can exhaust it; it is not an unlimited combustion source.")
PARAMETER("opening_size", "Case opening diameter / width / height", "Circle uses diameter; rectangle uses width U and height V. Dimensions in mm. A hole must fit its wall without overlapping another hole.")
PARAMETER("opening_center", "Case opening center U/V", "Local coordinates in mm relative to wall center. Top/bottom use X,Y; X walls use Y,Z; Y walls use Z,X.")
PARAMETER("port_a", "First contact surface", "ID of the first endpoint port. Must refer to an existing declared surface.")
PARAMETER("port_b", "Second contact surface", "ID of the second endpoint port. Changing an ID redirects the heat path; it does not move the surface.")
PARAMETER("exchange_area_m2", "Radiating exchange area", "Area contributing to radiative exchange, shown in mm2. Separate from conductive contact area.")
PARAMETER("effective_emissivity", "Effective emissivity [0..1]", "Multiplier for radiative exchange. Does not alter conductive or mass-transfer laws.")
PARAMETER("area_m2", "Contact area", "Geometric area of the selected surface, displayed in mm2. Keep consistent with its dimensions and thermal discretization.")
PARAMETER("rectangle_m", "Contact rectangle dimensions", "Width and height of a rectangular contact patch, displayed in mm.")
PARAMETER("centroid_m", "Contact center", "Center of the declared contact patch in contract coordinates, displayed in mm.")
PARAMETER("normal", "Outward normal", "Unit direction vector used by directional contact geometry; not a flow velocity.")
PARAMETER("to", "Destination node or gas region", "Endpoint identifier: circuit node in Circuit, receiving gas region in vent connections. outside_domain denotes exterior gas.")
PARAMETER("mixing_diffusivity_m2_s", "Gas mixing diffusivity [m2/s]", "Diffusive redistribution between connected gas volumes, in addition to pressure-driven directed transport.")
PARAMETER("mixing_flow_fraction", "Flow-induced mixing multiplier", "Strength of extra mixing associated with the directed mass flow. Does not create gas or energy.")
PARAMETER("thermal_stirring_coefficient", "Buoyancy mixing multiplier", "Strength of temperature-driven stirring in the reduced gas model; not a resolved CFD velocity.")
PARAMETER("thermal_stirring_length_m", "Buoyancy mixing length", "Characteristic length in the stirring model, displayed in mm.")
PARAMETER("mixing_length_cap_m", "Mixing length limit", "Maximum permitted mixing length, displayed in mm. Used to limit the reduced mixing model's spatial scale.")
PARAMETER("dynamic_viscosity_pa_s", "Gas dynamic viscosity [Pa s]", "Viscous resistance parameter in the gas model. It is not a thermal conduction coefficient.")
PARAMETER("cv_j_per_kg_k", "Gas specific heat Cv [J/(kg K)]", "Sensible internal energy storage per gas mass per kelvin; composition may contribute additional inventory-dependent properties.")
PARAMETER("specific_r_j_per_kg_k", "Gas specific constant [J/(kg K)]", "Specific gas constant used in the equation of state linking mass, free volume, temperature and pressure.")
PARAMETER("port_id", "Cooling surface", "Declared port connected to the environmental or coolant thermal boundary.")
PARAMETER("temperature_k", "Coolant / boundary temperature", "Constant imposed boundary temperature, displayed in Celsius. An attached measured temperature profile takes precedence.")
PARAMETER("area_fraction", "Radiating area fraction [0..1]", "Fraction of the boundary surface exposed to radiation.")
PARAMETER("reference_node", "Electrical reference node", "Ground/reference node for the DC circuit potential solve. It is not necessarily the physical enclosure.")
PARAMETER("from", "Source electrical node", "Positive/origin node of the oriented branch; combined with To defines circuit topology.")
PARAMETER("cell_id", "Battery / element reference", "Identifier of the object assigned to this electrical branch or measurement. Does not guarantee an experimental thermocouple's physical location.")
PARAMETER("emf_v", "Battery EMF [V]", "Electromotive force assigned to a battery branch; separate from its internal resistance and the external supply voltage.")
PARAMETER("current_a", "Applied current [A]", "Current drive of this source/battery. Positive battery current denotes charging in the supported model.")
PARAMETER("voltage_v", "Applied voltage [V]", "Supply voltage. For a series wiring wizard this is the TOTAL voltage, not a voltage per battery.")
PARAMETER("start_s", "Power-on time [s]", "Simulation time when this drive becomes active.")
PARAMETER("stop_s", "Power-off time [s]", "Simulation time when this drive stops; existing measured profiles are preserved.")
PARAMETER("duration_s", "Simulation duration [s]", "End time of the next run, not a fixed 3000-second application limit.")
PARAMETER("max_dt_s", "Maximum physical timestep [s]", "Upper bound on the physical integrator step. Not frame rate or replay speed; the solver may need smaller accepted steps.")
PARAMETER("minimum_dt_s", "Minimum permitted timestep [s]", "Numerical lower bound required by the configured run. Do not relax it to conceal balance or convergence failures.")
PARAMETER("output_interval_s", "Recording interval [s]", "Spacing of emitted observations/history. Separate from internal integration accuracy.")
PARAMETER("step_interval_s", "Integration output interval [s]", "Outer integration/observation interval used by this scenario; distinct from internal adaptive physical substeps.")
PARAMETER("stability_factor", "Explicit thermal safety factor [0..1]", "Margin used by explicit thermal stability limits. Smaller values are more conservative, usually slower.")
PARAMETER("divisions", "Thermal grid divisions X/Y/Z", "Number of thermal zones along each local axis. Shell subdivisions must align with the contents/contact geometry. More zones require a convergence check.")
PARAMETER("coupled_transport_interval_s", "Gas/thermal coupling interval [s]", "Physical interval used to couple mass transport and thermal evolution. Not a GUI refresh interval.")
PARAMETER("averaged_pressure_iterations", "Pressure iteration limit", "Maximum iterations of the configured averaged pressure solve. Increasing it is not a substitute for checking convergence.")
PARAMETER("averaged_payload_iterations", "Transport iteration limit", "Maximum iterations for coupled transported quantities in the averaged network solver.")
PARAMETER("notes", "Measurement location notes", "Human-readable provenance and uncertainty of the sensor mapping; not a fitted physical parameter.")
PARAMETER("artifact_id", "Experimental data artifact", "Reference to the source dataset/artifact used by this measurement.")
PARAMETER("time_column", "Experimental time column", "Name of the time column in the referenced data.")
PARAMETER("value_column", "Experimental value column", "Name of the measured quantity column; retain its documented units.")
PARAMETER("time_offset_s", "Experiment time offset [s]", "Time alignment of the recorded measurement; does not shift the physical solver's reactions.")
