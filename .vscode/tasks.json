        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BatterySim: build debug",
      "type": "process",
      "command": "${workspaceFolder}/scripts/ide-cmake.sh",
      "args": [
        "--build",
        "--preset",
        "viewer-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "BatterySim: configure debug",
      "dependsOrder": "sequence"
    },
    {
      "label": "BatterySim: configure headless",
      "type": "process",
      "command": "${workspaceFolder}/scripts/ide-cmake.sh",
      "args": [
        "--preset",
        "headless"
      ],
