        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BatterySim: build headless",
      "type": "process",
      "command": "${workspaceFolder}/scripts/ide-cmake.sh",
      "args": [
        "--build",
        "--preset",
        "headless"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "BatterySim: configure headless",
      "dependsOrder": "sequence"
    },
    {
      "label": "BatterySim: configure server",
      "type": "process",
      "command": "${workspaceFolder}/scripts/ide-cmake.sh",
      "args": [
        "--preset",
        "server"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BatterySim: build server",
      "type": "process",
      "command": "${workspaceFolder}/scripts/ide-cmake.sh",
      "args": [
        "--build",
        "--preset",
        "server"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "BatterySim: configure server",
