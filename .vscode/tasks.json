    },
    {
      "label": "BatterySim: configure core",
      "type": "process",
      "command": "${workspaceFolder}/scripts/ide-cmake.sh",
      "args": [
        "--preset",
        "core"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BatterySim: build core",
      "type": "process",
      "command": "${workspaceFolder}/scripts/ide-cmake.sh",
      "args": [
        "--build",
        "--preset",
        "core"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "BatterySim: configure core",
