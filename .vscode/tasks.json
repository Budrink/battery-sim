{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BatterySim: configure dev",
      "type": "process",
      "command": "${workspaceFolder}/scripts/ide-cmake.sh",
      "args": [
        "--preset",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BatterySim: build viewer",
      "type": "process",
      "command": "${workspaceFolder}/scripts/ide-cmake.sh",
      "args": [
        "--build",
        "--preset",
        "viewer"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": "BatterySim: configure dev",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "BatterySim: configure debug",
      "type": "process",
      "command": "${workspaceFolder}/scripts/ide-cmake.sh",
      "args": [
        "--preset",
        "debug"
      ],
